# Launcher reads this as plain configuration; exported environment wins.
# Leave empty for a generated private data/admin-token file.
ADMIN_TOKEN=
FRONTEND_ORIGIN=http://localhost:5173
# Relative paths resolve from project/ when using the launcher.
GAADE_DATA_DIR=./data
# Set only after explicitly downloading the approved local model snapshots.
E5_MODEL_PATH=
WHISPER_MODEL_PATH=

# Optional cloud search only when selected in the UI; local mode stays default.
# Select openai OR gemini and a model available to your API account that supports
# structured output; web fallback also requires that model's search tool support.
GAADE_AI_PROVIDER=gemini
GAADE_AI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
GEMINI_API_KEY=
GAADE_AI_WEB_FALLBACK=false

# Optional additional provider; Gemini remains the default above.
GROQ_API_KEY=
GAADE_GROQ_MODEL=openai/gpt-oss-20b

GAADE_TTS_ENABLED=true

GAADE_TTS_MODEL=gemini-3.8-flash-lite-tts

# Optional cloud deployment; leave empty to keep local SQLite/files/MLX.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gaade-private
GAADE_SPEECH_PROVIDER=local
